[submodule "lib/open.mp-sdk"]
	path = lib/open.mp-sdk
	url = https://github.com/openmultiplayer/open.mp-sdk
[submodule "lib/pawn-natives"]
	path = lib/pawn-natives
	url = https://github.com/openmultiplayer/pawn-natives
[submodule "lib/pawn"]
	path = lib/pawn
	url = https://github.com/openmultiplayer/compiler
[submodule "lib/entt"]
	path = lib/entt
	url = https://github.com/skypjack/entt
[submodule "lib/spdlog"]
	path = lib/spdlog
	url = https://github.com/gabime/spdlog
[submodule "lib/unordered_dense"]
	path = lib/unordered_dense
	url = https://github.com/martinus/unordered_dense
[submodule "lib/fmt"]
	path = lib/fmt
	url = https://github.com/fmtlib/fmt.git
[submodule "lib/libsodium"]
	path = lib/libsodium
	url = https://github.com/jedisct1/libsodium.git
